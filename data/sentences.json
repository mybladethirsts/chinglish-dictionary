{
  "meta": {
    "name": "中式英语词典-句型层：中文语序 ↔ 标准英语",
    "version": "0.1",
    "entry_count": 180,
    "pattern_count": 15,
    "note": "给英语母语者看的资源：每个中文句子都有‘中文语序直译英文’（Chinglish）和‘标准英文’两个版本，并标注中文的语序习惯。"
  },
  "patterns": [
    {"id": "P01", "name_zh": "时间状语前置", "name_en": "Time word first", "desc_zh": "中文把时间放在句首或动词前，时态靠时间词表达，不靠动词变形", "desc_en": "Chinese puts the time word first (or before the verb); tense is carried by the time word, not by changing the verb."},
    {"id": "P02", "name_zh": "时态由时间词表达", "name_en": "Tense via time word", "desc_zh": "过去/将来靠‘昨天、明天、已经’这类词，动词不做时态变化", "desc_en": "Past and future are shown by words like 'yesterday / tomorrow / already'; the verb does not change form."},
    {"id": "P03", "name_zh": "系动词省略", "name_en": "No copula 'is/are'", "desc_zh": "形容词直接当谓语：‘这很好’不说‘这是好’", "desc_en": "Adjectives work directly as predicates: 'This machine very good' instead of 'This machine is very good'."},
    {"id": "P04", "name_zh": "话题置顶", "name_en": "Topic first", "desc_zh": "先说出要谈论的对象，再说对它的话：‘这个项目我们三家一起做’", "desc_en": "The topic comes first, then the comment: 'This project we three companies together do.' The topic is announced, then commented on."},
    {"id": "P05", "name_zh": "连动结构", "name_en": "Verb chaining", "desc_zh": "两个动作直接连着说，不加 and / to", "desc_en": "Two actions chain directly without 'and' or 'to': 'Go buy some water.'"},
    {"id": "P06", "name_zh": "量词直译", "name_en": "Measure words", "desc_zh": "中文量词（个/片/杯）直译成 piece / cup，或干脆省略 of", "desc_en": "Measure words like 'piece / cup' are carried over, and 'of' is often dropped: 'two piece bread'."},
    {"id": "P07", "name_zh": "介词直译或省略", "name_en": "Prepositions", "desc_zh": "去/在/来自等按中文习惯直译，in / to / at 常省略", "desc_en": "Prepositions follow Chinese habits: 'go Beijing', 'live Guangzhou' — 'to / in' are often dropped."},
    {"id": "P08", "name_zh": "否定用 no 不用 not", "name_en": "'No' instead of 'don't'", "desc_zh": "中文‘不’直接放动词前：我不去 = I no go", "desc_en": "Chinese '不' lands directly before the verb: 'I no go' instead of 'I don't go'."},
    {"id": "P09", "name_zh": "副词位置直译", "name_en": "Adverb position", "desc_zh": "也/都/还/就等副词按中文位置直译", "desc_en": "Adverbs like 'also / all / still' keep their Chinese position: 'I also want buy one'."},
    {"id": "P10", "name_zh": "因为…所以…双关联词", "name_en": "'Because...so'", "desc_zh": "中文习惯‘因为…，所以…’两个词都用，英文只用其一", "desc_en": "Chinese uses both 'because' and 'so' in one sentence; English normally uses only one."},
    {"id": "P11", "name_zh": "名词不标复数", "name_en": "No plural marking", "desc_zh": "数词后面的名词不加 s：两只狗 = two dog", "desc_en": "Nouns after numbers don't take an -s: 'two dog', 'three apple'."},
    {"id": "P12", "name_zh": "冠词省略", "name_en": "No articles", "desc_zh": "a / an / the 在中文里没有对应，常被省略", "desc_en": "There are no articles in Chinese, so a / an / the are often dropped: 'He is teacher'."},
    {"id": "P13", "name_zh": "完成靠‘已经/完’", "name_en": "'Already / done'", "desc_zh": "完成动作靠‘已经’或‘完’，不用 have + 过去分词", "desc_en": "Completion is shown by 'already / done' rather than have + past participle: 'I finish work already'."},
    {"id": "P14", "name_zh": "情态直译", "name_en": "Modals & softeners", "desc_zh": "可以/应该/要按中文直觉直译，语气词不精确对应", "desc_en": "Chinese modals map directly onto English ones without the full range of English softeners: 'You should no worry'."},
    {"id": "P15", "name_zh": "语气词直译", "name_en": "Sentence particles", "desc_zh": "啊/吧/呢/嘛/啦是中文句尾语气词，常被直译成 ah / ba / ne / la", "desc_en": "Chinese ends sentences with particles (啊/吧/呢/嘛/啦); learners often transliterate them as 'ah / ba / ne / la'."}
  ],
  "entries": [
    {"id": "S001", "zh": "昨天我们讨论过了，今天只是确认一下。", "chinglish": "Yesterday we discuss already, today we just confirm.", "standard": "We already discussed it yesterday; today we're just confirming.", "pattern": "P01", "notes": "The time word 'yesterday' opens the sentence and does the work of the past tense."},
    {"id": "S002", "zh": "明天我去上海。", "chinglish": "Tomorrow I go Shanghai.", "standard": "I'll go to Shanghai tomorrow.", "pattern": "P01", "notes": "Time first; future is implied by 'tomorrow', and 'to' is dropped (see also P07)."},
    {"id": "S003", "zh": "今天天气很好。", "chinglish": "Today weather very good.", "standard": "The weather is very good today.", "pattern": "P01", "notes": "Time first; no copula (P03) and no article (P12)."},
    {"id": "S004", "zh": "昨晚我看电视了。", "chinglish": "Last night I watch TV.", "standard": "I watched TV last night.", "pattern": "P01", "notes": "Past tense carried by 'last night', not by the verb."},
    {"id": "S005", "zh": "下个星期我们有会议。", "chinglish": "Next week we have meeting.", "standard": "We have a meeting next week.", "pattern": "P01", "notes": "Time first; 'a' is dropped (P12)."},
    {"id": "S006", "zh": "我每天起得很早。", "chinglish": "Every day I get up early.", "standard": "I get up early every day.", "pattern": "P01", "notes": "Chinese puts 'every day' at the front of the clause."},
    {"id": "S007", "zh": "星期一我去办公室。", "chinglish": "Monday I go to office.", "standard": "I go to the office on Monday.", "pattern": "P01", "notes": "The weekday leads; 'the' is dropped (P12)."},
    {"id": "S008", "zh": "昨天他买了一辆车。", "chinglish": "Yesterday he buy a car.", "standard": "He bought a car yesterday.", "pattern": "P01", "notes": "Past from 'yesterday', not from the verb form."},
    {"id": "S009", "zh": "今天早上我吃了面包。", "chinglish": "This morning I eat bread.", "standard": "I had bread this morning.", "pattern": "P01", "notes": "Time first; no tense change on the verb."},
    {"id": "S010", "zh": "下班后我回家。", "chinglish": "After work I go home.", "standard": "After work, I go home.", "pattern": "P01", "notes": "This one actually matches English order — a happy overlap."},
    {"id": "S011", "zh": "三天前她来到了这里。", "chinglish": "Three days ago she come here.", "standard": "She came here three days ago.", "pattern": "P01", "notes": "Time phrase first; verb stays base form."},
    {"id": "S012", "zh": "现在我没有时间。", "chinglish": "Now I no have time.", "standard": "I don't have time right now.", "pattern": "P01", "notes": "Time first, plus the no+verb negation pattern (P08)."},
    {"id": "S013", "zh": "他昨天去上学了。", "chinglish": "He go to school yesterday.", "standard": "He went to school yesterday.", "pattern": "P02", "notes": "'yesterday' marks the past; 'go' stays unchanged."},
    {"id": "S014", "zh": "我已经吃了。", "chinglish": "I already eat.", "standard": "I've already eaten.", "pattern": "P02", "notes": "'already' carries completion instead of have + past participle."},
    {"id": "S015", "zh": "她上周来了。", "chinglish": "She come last week.", "standard": "She came last week.", "pattern": "P02", "notes": "Time word marks the tense."},
    {"id": "S016", "zh": "我们明天完成这项工作。", "chinglish": "We finish this work tomorrow.", "standard": "We'll finish this work tomorrow.", "pattern": "P02", "notes": "Future shown by 'tomorrow', not by 'will'."},
    {"id": "S017", "zh": "我以前见过他。", "chinglish": "I see him before.", "standard": "I've seen him before.", "pattern": "P02", "notes": "'before' implies the experience; no perfect tense needed."},
    {"id": "S018", "zh": "他们昨晚到了。", "chinglish": "They arrive yesterday night.", "standard": "They arrived last night.", "pattern": "P02", "notes": "'yesterday night' is a direct translation of 昨晚; English says 'last night'."},
    {"id": "S019", "zh": "他说他要来。", "chinglish": "He say he come.", "standard": "He said he would come.", "pattern": "P02", "notes": "No tense or modal marking; context does the work."},
    {"id": "S020", "zh": "我在这里住了十年。", "chinglish": "I live here ten years.", "standard": "I've lived here for ten years.", "pattern": "P02", "notes": "Duration with no perfect tense and no 'for'."},
    {"id": "S021", "zh": "她已经回家了。", "chinglish": "She already go home.", "standard": "She's already gone home.", "pattern": "P02", "notes": "'already' + base verb instead of present perfect."},
    {"id": "S022", "zh": "我们上个月见过面。", "chinglish": "We meet last month.", "standard": "We met last month.", "pattern": "P02", "notes": "Same pattern: the time word is the tense."},
    {"id": "S023", "zh": "我刚刚做完作业。", "chinglish": "I finish homework just now.", "standard": "I just finished my homework.", "pattern": "P02", "notes": "'just now' (刚刚) marks recent past."},
    {"id": "S024", "zh": "他在这家公司工作五年了。", "chinglish": "He work in this company five years.", "standard": "He has worked at this company for five years.", "pattern": "P02", "notes": "Duration phrase without 'for' or perfect tense."},
    {"id": "S025", "zh": "这台机器很好。", "chinglish": "This machine very good.", "standard": "This machine is very good.", "pattern": "P03", "notes": "The copula 'is' is simply absent; the adjective is the predicate."},
    {"id": "S026", "zh": "我的英语不好。", "chinglish": "My English not good.", "standard": "My English is not good.", "pattern": "P03", "notes": "No copula; negation with 'not' directly before the adjective."},
    {"id": "S027", "zh": "她非常漂亮。", "chinglish": "She very beautiful.", "standard": "She is very beautiful.", "pattern": "P03", "notes": "Copula dropped after the subject."},
    {"id": "S028", "zh": "他今天很忙。", "chinglish": "He very busy today.", "standard": "He is very busy today.", "pattern": "P03", "notes": "Adjective predicate; time word at the end."},
    {"id": "S029", "zh": "这个食物很好吃。", "chinglish": "The food delicious.", "standard": "The food is delicious.", "pattern": "P03", "notes": "No 'is' needed in Chinese thinking."},
    {"id": "S030", "zh": "我饿了。", "chinglish": "I hungry.", "standard": "I'm hungry.", "pattern": "P03", "notes": "Even 'I am' collapses to 'I' + adjective."},
    {"id": "S031", "zh": "我们很开心。", "chinglish": "We happy.", "standard": "We are happy.", "pattern": "P03", "notes": "Subject + adjective = complete statement."},
    {"id": "S032", "zh": "这个价格太高了。", "chinglish": "The price too high.", "standard": "The price is too high.", "pattern": "P03", "notes": "'too' + adjective without a copula."},
    {"id": "S033", "zh": "他们生我的气。", "chinglish": "They angry with me.", "standard": "They are angry with me.", "pattern": "P03", "notes": "Copula dropped; 'angry with' kept."},
    {"id": "S034", "zh": "这个问题很严重。", "chinglish": "This problem serious.", "standard": "This problem is serious.", "pattern": "P03", "notes": "Standard copula omission."},
    {"id": "S035", "zh": "这个房间很干净。", "chinglish": "The room clean.", "standard": "The room is clean.", "pattern": "P03", "notes": "Adjective as predicate, no 'is'."},
    {"id": "S036", "zh": "他生病了。", "chinglish": "He sick.", "standard": "He is sick.", "pattern": "P03", "notes": "Same omission; 'sick' carries the state."},
    {"id": "S037", "zh": "这个项目我们三家一起做。", "chinglish": "This project we three companies together do.", "standard": "Three companies are doing this project together.", "pattern": "P04", "notes": "Topic ('this project') is announced first, then the comment."},
    {"id": "S038", "zh": "这个问题我没办法。", "chinglish": "This problem I no solution.", "standard": "I have no solution to this problem.", "pattern": "P04", "notes": "Topic first, then 'I have no solution'."},
    {"id": "S039", "zh": "那个电影我看过。", "chinglish": "That movie I seen.", "standard": "I've seen that movie.", "pattern": "P04", "notes": "Topic ('that movie') fronted; the verb stays short."},
    {"id": "S040", "zh": "钱我不多。", "chinglish": "Money I no much.", "standard": "I don't have much money.", "pattern": "P04", "notes": "Topic 'money' first; comment 'I no much'."},
    {"id": "S041", "zh": "这本书我非常喜欢。", "chinglish": "This book I very like.", "standard": "I like this book very much.", "pattern": "P04", "notes": "Object/topic fronted; adverb before verb."},
    {"id": "S042", "zh": "会议明天早上我们开。", "chinglish": "The meeting tomorrow morning we have.", "standard": "We're having the meeting tomorrow morning.", "pattern": "P04", "notes": "Topic + time, then the comment."},
    {"id": "S043", "zh": "这个食物我不吃。", "chinglish": "This food I no eat.", "standard": "I don't eat this food.", "pattern": "P04", "notes": "Topic first; no+verb negation."},
    {"id": "S044", "zh": "英语我说得不好。", "chinglish": "English I no good speak.", "standard": "I don't speak English well.", "pattern": "P04", "notes": "Topic 'English' fronted; comment is the whole clause."},
    {"id": "S045", "zh": "工作我们已经完成了。", "chinglish": "The work we already finish.", "standard": "We've already finished the work.", "pattern": "P04", "notes": "Topic fronted; 'already' carries completion."},
    {"id": "S046", "zh": "这个问题我问你。", "chinglish": "This question I ask you.", "standard": "I want to ask you this question.", "pattern": "P04", "notes": "Topic + 'I ask you'; English needs more structure."},
    {"id": "S047", "zh": "那个地方我们不去。", "chinglish": "That place we no go.", "standard": "We don't go to that place.", "pattern": "P04", "notes": "Topic fronted; no+verb; no 'to'."},
    {"id": "S048", "zh": "那辆车他昨天买的。", "chinglish": "The car he buy yesterday.", "standard": "He bought the car yesterday.", "pattern": "P04", "notes": "Topic fronted, then subject + verb + time."},
    {"id": "S049", "zh": "去买点水。", "chinglish": "Go buy some water.", "standard": "Go and buy some water.", "pattern": "P05", "notes": "Two verbs chain without 'and'."},
    {"id": "S050", "zh": "我去看电影。", "chinglish": "I go see movie.", "standard": "I'm going to see a movie.", "pattern": "P05", "notes": "'Go + see' chains directly; no article."},
    {"id": "S051", "zh": "来吃晚饭。", "chinglish": "Come eat dinner.", "standard": "Come and have dinner.", "pattern": "P05", "notes": "Imperative verb chain without 'and'."},
    {"id": "S052", "zh": "他每天去游泳。", "chinglish": "He go swim every day.", "standard": "He goes swimming every day.", "pattern": "P05", "notes": "'Go swim' instead of 'go swimming'."},
    {"id": "S053", "zh": "我们去购物买衣服。", "chinglish": "We go shopping buy clothes.", "standard": "We went shopping to buy clothes.", "pattern": "P05", "notes": "Purpose chains directly without 'to'."},
    {"id": "S054", "zh": "她来帮我。", "chinglish": "She come help me.", "standard": "She came to help me.", "pattern": "P05", "notes": "'Come + help' instead of 'came to help'."},
    {"id": "S055", "zh": "我去问他。", "chinglish": "I go ask him.", "standard": "I'll go and ask him.", "pattern": "P05", "notes": "Two verbs, no connector."},
    {"id": "S056", "zh": "你去看看。", "chinglish": "You go check.", "standard": "Go and check.", "pattern": "P05", "notes": "Chained imperatives."},
    {"id": "S057", "zh": "他们去打篮球。", "chinglish": "They go play basketball.", "standard": "They went to play basketball.", "pattern": "P05", "notes": "'Go play' instead of 'went to play'."},
    {"id": "S058", "zh": "我去看一看。", "chinglish": "I go take a look.", "standard": "I'll go take a look.", "pattern": "P05", "notes": "This one actually works in casual English too."},
    {"id": "S059", "zh": "来坐这里。", "chinglish": "Come sit here.", "standard": "Come and sit here.", "pattern": "P05", "notes": "Imperative chain."},
    {"id": "S060", "zh": "他去开门。", "chinglish": "He go open the door.", "standard": "He went to open the door.", "pattern": "P05", "notes": "'Go open' instead of 'went to open'."},
    {"id": "S061", "zh": "我要两片面包。", "chinglish": "I want two piece bread.", "standard": "I'd like two pieces of bread.", "pattern": "P06", "notes": "Measure word 'piece' carried over; no plural, no 'of'."},
    {"id": "S062", "zh": "一杯水，谢谢。", "chinglish": "A cup water please.", "standard": "A cup of water, please.", "pattern": "P06", "notes": "'of' is dropped after the measure word."},
    {"id": "S063", "zh": "三碗米饭。", "chinglish": "Three bowl rice.", "standard": "Three bowls of rice.", "pattern": "P06", "notes": "Measure word + noun, no plural or 'of'."},
    {"id": "S064", "zh": "两张纸。", "chinglish": "Two sheet paper.", "standard": "Two sheets of paper.", "pattern": "P06", "notes": "'sheet' doubles as the measure word."},
    {"id": "S065", "zh": "一杯果汁。", "chinglish": "One glass juice.", "standard": "A glass of juice.", "pattern": "P06", "notes": "Measure word without 'of'."},
    {"id": "S066", "zh": "五瓶啤酒。", "chinglish": "Five bottle beer.", "standard": "Five bottles of beer.", "pattern": "P06", "notes": "No plural on the measure word."},
    {"id": "S067", "zh": "一双鞋。", "chinglish": "A pair shoe.", "standard": "A pair of shoes.", "pattern": "P06", "notes": "'pair' + noun, no plural."},
    {"id": "S068", "zh": "两杯咖啡。", "chinglish": "Two cup coffee.", "standard": "Two cups of coffee.", "pattern": "P06", "notes": "Same measure-word pattern."},
    {"id": "S069", "zh": "一块蛋糕。", "chinglish": "One piece cake.", "standard": "One piece of cake.", "pattern": "P06", "notes": "'piece' without 'of'."},
    {"id": "S070", "zh": "三张票。", "chinglish": "Three ticket.", "standard": "Three tickets.", "pattern": "P06", "notes": "No measure word, no plural — just number + noun."},
    {"id": "S071", "zh": "一群人。", "chinglish": "A group people.", "standard": "A group of people.", "pattern": "P06", "notes": "'group' + noun, no 'of'."},
    {"id": "S072", "zh": "四瓶水。", "chinglish": "Four bottle water.", "standard": "Four bottles of water.", "pattern": "P06", "notes": "Measure word carries the counting; noun unchanged."},
    {"id": "S073", "zh": "我明天去北京。", "chinglish": "I go Beijing tomorrow.", "standard": "I'll go to Beijing tomorrow.", "pattern": "P07", "notes": "'go' takes the city directly — no 'to'."},
    {"id": "S074", "zh": "我住在广州。", "chinglish": "I live Guangzhou.", "standard": "I live in Guangzhou.", "pattern": "P07", "notes": "'live' + city, no 'in'."},
    {"id": "S075", "zh": "他来自美国。", "chinglish": "He come from USA.", "standard": "He comes from the US.", "pattern": "P07", "notes": "'from' kept; no article before USA."},
    {"id": "S076", "zh": "我们在会上讨论了这个问题。", "chinglish": "We discuss this problem on meeting.", "standard": "We discussed this problem at the meeting.", "pattern": "P07", "notes": "'on meeting' instead of 'at the meeting'."},
    {"id": "S077", "zh": "我今天没去学校。", "chinglish": "I no go school today.", "standard": "I didn't go to school today.", "pattern": "P07", "notes": "no+verb (P08); no 'to' before school."},
    {"id": "S078", "zh": "她坐在椅子上。", "chinglish": "She sit on chair.", "standard": "She sat on the chair.", "pattern": "P07", "notes": "No article before 'chair'."},
    {"id": "S079", "zh": "周一我们有会议。", "chinglish": "On Monday we have meeting.", "standard": "We have a meeting on Monday.", "pattern": "P07", "notes": "Time first with 'on'; no article."},
    {"id": "S080", "zh": "我在门口等你。", "chinglish": "I wait you at door.", "standard": "I'll wait for you at the door.", "pattern": "P07", "notes": "'wait you' instead of 'wait for you'."},
    {"id": "S081", "zh": "他开车去上班。", "chinglish": "He go to work by car.", "standard": "He goes to work by car.", "pattern": "P07", "notes": "'by car' actually matches English here."},
    {"id": "S082", "zh": "书在桌子上。", "chinglish": "The book on table.", "standard": "The book is on the table.", "pattern": "P07", "notes": "No copula + no article."},
    {"id": "S083", "zh": "我到家了。", "chinglish": "I arrive at home.", "standard": "I've arrived home.", "pattern": "P07", "notes": "'arrive at home' instead of 'arrived home'."},
    {"id": "S084", "zh": "我们打电话聊了。", "chinglish": "We talk on phone.", "standard": "We talked on the phone.", "pattern": "P07", "notes": "'on phone' without 'the'."},
    {"id": "S085", "zh": "我不知道。", "chinglish": "I no know.", "standard": "I don't know.", "pattern": "P08", "notes": "The classic: 'no' directly before the verb."},
    {"id": "S086", "zh": "他没来。", "chinglish": "He no come.", "standard": "He didn't come.", "pattern": "P08", "notes": "Negation without 'didn't'."},
    {"id": "S087", "zh": "我们没有钱。", "chinglish": "We no have money.", "standard": "We don't have money.", "pattern": "P08", "notes": "no + have."},
    {"id": "S088", "zh": "她不喜欢咖啡。", "chinglish": "She no like coffee.", "standard": "She doesn't like coffee.", "pattern": "P08", "notes": "no + like."},
    {"id": "S089", "zh": "我不想去。", "chinglish": "I no want go.", "standard": "I don't want to go.", "pattern": "P08", "notes": "no + want + go, no 'to'."},
    {"id": "S090", "zh": "他们不同意。", "chinglish": "They no agree.", "standard": "They don't agree.", "pattern": "P08", "notes": "no + agree."},
    {"id": "S091", "zh": "你别担心。", "chinglish": "You no worry.", "standard": "Don't worry.", "pattern": "P08", "notes": "Imperative negation with 'no'."},
    {"id": "S092", "zh": "我不明白。", "chinglish": "I no understand.", "standard": "I don't understand.", "pattern": "P08", "notes": "no + understand."},
    {"id": "S093", "zh": "他不吃肉。", "chinglish": "He no eat meat.", "standard": "He doesn't eat meat.", "pattern": "P08", "notes": "no + eat."},
    {"id": "S094", "zh": "我们没看见他。", "chinglish": "We no see him.", "standard": "We didn't see him.", "pattern": "P08", "notes": "no + see."},
    {"id": "S095", "zh": "我不喜欢这个。", "chinglish": "I no like this.", "standard": "I don't like this.", "pattern": "P08", "notes": "no + like + this."},
    {"id": "S096", "zh": "她没告诉我。", "chinglish": "She no tell me.", "standard": "She didn't tell me.", "pattern": "P08", "notes": "no + tell."},
    {"id": "S097", "zh": "我也要买一个。", "chinglish": "I also want buy one.", "standard": "I also want to buy one.", "pattern": "P09", "notes": "'also' before the verb; 'to' dropped after want."},
    {"id": "S098", "zh": "我们都去。", "chinglish": "We all go.", "standard": "We all went.", "pattern": "P09", "notes": "'all' before the verb, as in Chinese."},
    {"id": "S099", "zh": "他还没来。", "chinglish": "He still no come.", "standard": "He still hasn't come.", "pattern": "P09", "notes": "'still + no' matches Chinese 还没."},
    {"id": "S100", "zh": "我就想看看。", "chinglish": "I just want see.", "standard": "I just want to look.", "pattern": "P09", "notes": "'just' in place; 'want see' chains (P05)."},
    {"id": "S101", "zh": "她也来。", "chinglish": "She also come.", "standard": "She's coming too.", "pattern": "P09", "notes": "'also' before the verb; 'too' at the end is the English habit."},
    {"id": "S102", "zh": "他们都同意。", "chinglish": "They all agree.", "standard": "They all agreed.", "pattern": "P09", "notes": "'all' before the verb."},
    {"id": "S103", "zh": "我非常喜欢它。", "chinglish": "I very much like it.", "standard": "I like it very much.", "pattern": "P09", "notes": "Intensifier before the verb, as in Chinese."},
    {"id": "S104", "zh": "他经常不来。", "chinglish": "He often no come.", "standard": "He often doesn't come.", "pattern": "P09", "notes": "Frequency adverb + no + verb."},
    {"id": "S105", "zh": "我们已经讨论过了。", "chinglish": "We already discuss.", "standard": "We've already discussed it.", "pattern": "P09", "notes": "'already' before the verb; completion via adverb (P13)."},
    {"id": "S106", "zh": "我只要水。", "chinglish": "I only want water.", "standard": "I only want water.", "pattern": "P09", "notes": "'only' works the same in both languages here."},
    {"id": "S107", "zh": "你先走。", "chinglish": "You first go.", "standard": "You go first.", "pattern": "P09", "notes": "'first' before the verb in Chinese order."},
    {"id": "S108", "zh": "我也不知道。", "chinglish": "I also no know.", "standard": "I don't know either.", "pattern": "P09", "notes": "'also no' = 也不; English uses 'either' at the end."},
    {"id": "S109", "zh": "因为我生病了，所以没来。", "chinglish": "Because I sick, so I no come.", "standard": "I didn't come because I was sick.", "pattern": "P10", "notes": "Chinese keeps both 'because' and 'so'; English uses one or the other."},
    {"id": "S110", "zh": "因为下雨，所以我们没去。", "chinglish": "Because rain, so we no go.", "standard": "We didn't go because of the rain.", "pattern": "P10", "notes": "Both connectives present."},
    {"id": "S111", "zh": "因为没钱，所以我没买。", "chinglish": "Because no money, so I no buy.", "standard": "I didn't buy it because I had no money.", "pattern": "P10", "notes": "Double connective + no+verb."},
    {"id": "S112", "zh": "因为忙，所以我没回。", "chinglish": "Because busy, so I no reply.", "standard": "I didn't reply because I was busy.", "pattern": "P10", "notes": "Because + adjective, then so."},
    {"id": "S113", "zh": "因为累了，所以我很早睡。", "chinglish": "Because tired, so I sleep early.", "standard": "I went to bed early because I was tired.", "pattern": "P10", "notes": "Double connective; no copula."},
    {"id": "S114", "zh": "因为贵，所以我不买。", "chinglish": "Because expensive, so I no buy.", "standard": "I won't buy it because it's too expensive.", "pattern": "P10", "notes": "Because + adjective; so + no + verb."},
    {"id": "S115", "zh": "因为他帮了我，所以我谢谢他。", "chinglish": "Because he help me, so I thank him.", "standard": "I thanked him because he helped me.", "pattern": "P10", "notes": "Both connectives; no tense marking."},
    {"id": "S116", "zh": "因为没时间，所以我们没完成。", "chinglish": "Because no time, so we no finish.", "standard": "We didn't finish because there was no time.", "pattern": "P10", "notes": "Double connective."},
    {"id": "S117", "zh": "因为晚了，所以我不等了。", "chinglish": "Because late, so I no wait.", "standard": "I didn't wait because it was late.", "pattern": "P10", "notes": "Because + adjective + so."},
    {"id": "S118", "zh": "因为冷，所以我多穿点衣服。", "chinglish": "Because cold, so I wear more clothes.", "standard": "I wore more clothes because it was cold.", "pattern": "P10", "notes": "Double connective."},
    {"id": "S119", "zh": "因为她没来，所以我们等着。", "chinglish": "Because she no come, so we wait.", "standard": "We waited because she hadn't come.", "pattern": "P10", "notes": "Both connectives; no+verb in the clause."},
    {"id": "S120", "zh": "因为没有公交车，所以我走路。", "chinglish": "Because no bus, so I walk.", "standard": "I walked because there was no bus.", "pattern": "P10", "notes": "Because + no + noun, then so."},
    {"id": "S121", "zh": "我有两本书。", "chinglish": "I have two book.", "standard": "I have two books.", "pattern": "P11", "notes": "Number + noun, no plural -s."},
    {"id": "S122", "zh": "他买了三个苹果。", "chinglish": "He buy three apple.", "standard": "He bought three apples.", "pattern": "P11", "notes": "No plural; no tense change."},
    {"id": "S123", "zh": "很多学生来了。", "chinglish": "Many student come.", "standard": "Many students came.", "pattern": "P11", "notes": "'many' + singular noun."},
    {"id": "S124", "zh": "我看见两只狗。", "chinglish": "I see two dog.", "standard": "I saw two dogs.", "pattern": "P11", "notes": "Number + noun, no -s."},
    {"id": "S125", "zh": "有五个孩子。", "chinglish": "There are five child.", "standard": "There are five children.", "pattern": "P11", "notes": "Even irregular plurals flatten to the base form."},
    {"id": "S126", "zh": "我们需要更多工人。", "chinglish": "We need more worker.", "standard": "We need more workers.", "pattern": "P11", "notes": "'more' + singular noun."},
    {"id": "S127", "zh": "她有很多朋友。", "chinglish": "She have many friend.", "standard": "She has many friends.", "pattern": "P11", "notes": "No plural; subject-verb agreement also flattens."},
    {"id": "S128", "zh": "他们有三台电脑。", "chinglish": "They have three computer.", "standard": "They have three computers.", "pattern": "P11", "notes": "Number + noun."},
    {"id": "S129", "zh": "我要两个鸡蛋。", "chinglish": "I want two egg.", "standard": "I want two eggs.", "pattern": "P11", "notes": "Number + noun, no -s."},
    {"id": "S130", "zh": "这家公司有 100 名员工。", "chinglish": "The company has 100 employee.", "standard": "The company has 100 employees.", "pattern": "P11", "notes": "Number + noun."},
    {"id": "S131", "zh": "我们吃了两根香蕉。", "chinglish": "We eat two banana.", "standard": "We ate two bananas.", "pattern": "P11", "notes": "No plural; tense from context."},
    {"id": "S132", "zh": "他有四个兄弟。", "chinglish": "He has four brother.", "standard": "He has four brothers.", "pattern": "P11", "notes": "Number + noun."},
    {"id": "S133", "zh": "他是老师。", "chinglish": "He is teacher.", "standard": "He is a teacher.", "pattern": "P12", "notes": "The indefinite article is absent."},
    {"id": "S134", "zh": "她是医生。", "chinglish": "She is doctor.", "standard": "She is a doctor.", "pattern": "P12", "notes": "No 'a' before the profession."},
    {"id": "S135", "zh": "我买了一辆车。", "chinglish": "I buy car.", "standard": "I bought a car.", "pattern": "P12", "notes": "No article; tense via context."},
    {"id": "S136", "zh": "他是个好学生。", "chinglish": "He is good student.", "standard": "He is a good student.", "pattern": "P12", "notes": "Adjective + noun without an article."},
    {"id": "S137", "zh": "我们有个会议。", "chinglish": "We have meeting.", "standard": "We have a meeting.", "pattern": "P12", "notes": "No article."},
    {"id": "S138", "zh": "狗是动物。", "chinglish": "Dog is animal.", "standard": "A dog is an animal.", "pattern": "P12", "notes": "Both articles dropped."},
    {"id": "S139", "zh": "我要一个苹果。", "chinglish": "I want apple.", "standard": "I want an apple.", "pattern": "P12", "notes": "No article."},
    {"id": "S140", "zh": "她给了我一本书。", "chinglish": "She give me book.", "standard": "She gave me a book.", "pattern": "P12", "notes": "No article; no tense change."},
    {"id": "S141", "zh": "他是工程师。", "chinglish": "He is engineer.", "standard": "He is an engineer.", "pattern": "P12", "notes": "No 'an'."},
    {"id": "S142", "zh": "我昨晚看了一部电影。", "chinglish": "I see movie last night.", "standard": "I saw a movie last night.", "pattern": "P12", "notes": "No article; time word marks the past."},
    {"id": "S143", "zh": "这是一辆新车。", "chinglish": "This is new car.", "standard": "This is a new car.", "pattern": "P12", "notes": "No article before the noun phrase."},
    {"id": "S144", "zh": "她有一个好主意。", "chinglish": "She has good idea.", "standard": "She has a good idea.", "pattern": "P12", "notes": "No article."},
    {"id": "S145", "zh": "我已经做完工作了。", "chinglish": "I finish work already.", "standard": "I've already finished the work.", "pattern": "P13", "notes": "'already' after the verb instead of have + past participle."},
    {"id": "S146", "zh": "他回家了。", "chinglish": "He gone home.", "standard": "He's gone home.", "pattern": "P13", "notes": "Past participle used alone, no auxiliary."},
    {"id": "S147", "zh": "我们做完了。", "chinglish": "We done.", "standard": "We're done.", "pattern": "P13", "notes": "'done' carries completion with no auxiliary."},
    {"id": "S148", "zh": "她已经走了。", "chinglish": "She left already.", "standard": "She's already left.", "pattern": "P13", "notes": "Past verb + 'already' at the end."},
    {"id": "S149", "zh": "我已经买了。", "chinglish": "I buy it already.", "standard": "I've already bought it.", "pattern": "P13", "notes": "Base verb + 'already' instead of perfect tense."},
    {"id": "S150", "zh": "他们完成了。", "chinglish": "They finish already.", "standard": "They've finished.", "pattern": "P13", "notes": "'already' marks completion."},
    {"id": "S151", "zh": "会议结束了。", "chinglish": "The meeting over.", "standard": "The meeting is over.", "pattern": "P13", "notes": "'over' as the predicate, no copula."},
    {"id": "S152", "zh": "我已经看过了。", "chinglish": "I seen it already.", "standard": "I've already seen it.", "pattern": "P13", "notes": "Past participle without auxiliary."},
    {"id": "S153", "zh": "他已经告诉我了。", "chinglish": "He tell me already.", "standard": "He's already told me.", "pattern": "P13", "notes": "Base verb + 'already'."},
    {"id": "S154", "zh": "我们吃过了。", "chinglish": "We eat already.", "standard": "We've eaten.", "pattern": "P13", "notes": "'already' instead of present perfect."},
    {"id": "S155", "zh": "她已经来了。", "chinglish": "She come already.", "standard": "She's already here.", "pattern": "P13", "notes": "'come already' marks arrival completion."},
    {"id": "S156", "zh": "我已经知道了。", "chinglish": "I know already.", "standard": "I already know.", "pattern": "P13", "notes": "'already' after the verb — the mirror of English."},
    {"id": "S157", "zh": "我觉得你可以试试。", "chinglish": "I think you can try.", "standard": "Maybe you could try.", "pattern": "P14", "notes": "Chinese softens with 'I think'; English prefers 'maybe/could'."},
    {"id": "S158", "zh": "你不要担心。", "chinglish": "You should no worry.", "standard": "You shouldn't worry.", "pattern": "P14", "notes": "Modal + no + verb instead of 'shouldn't'."},
    {"id": "S159", "zh": "我想问你一件事。", "chinglish": "I want ask you one thing.", "standard": "I'd like to ask you something.", "pattern": "P14", "notes": "'want ask' chains; 'one thing' is a direct translation."},
    {"id": "S160", "zh": "我们不能这样做。", "chinglish": "We can no do this.", "standard": "We can't do this.", "pattern": "P14", "notes": "'can no' instead of 'can't'."},
    {"id": "S161", "zh": "你不能在这里抽烟。", "chinglish": "You can no smoke here.", "standard": "You can't smoke here.", "pattern": "P14", "notes": "'can no smoke' instead of 'can't smoke'."},
    {"id": "S162", "zh": "我建议不去。", "chinglish": "I suggest no go.", "standard": "I suggest we don't go.", "pattern": "P14", "notes": "'suggest no go' — the object is a bare verb."},
    {"id": "S163", "zh": "你应当更小心。", "chinglish": "You should more careful.", "standard": "You should be more careful.", "pattern": "P14", "notes": "Modal + adverb + adjective, no copula."},
    {"id": "S164", "zh": "也许我们不需要。", "chinglish": "Maybe we no need.", "standard": "Maybe we don't need it.", "pattern": "P14", "notes": "'maybe' + no + verb."},
    {"id": "S165", "zh": "我不确定。", "chinglish": "I no sure.", "standard": "I'm not sure.", "pattern": "P14", "notes": "no + adjective instead of 'am not'."},
    {"id": "S166", "zh": "你千万别忘了。", "chinglish": "You must no forget.", "standard": "You mustn't forget.", "pattern": "P14", "notes": "'must no' instead of 'mustn't'."},
    {"id": "S167", "zh": "请不要碰。", "chinglish": "Please no touch.", "standard": "Please don't touch.", "pattern": "P14", "notes": "'please no touch' — imperative negation."},
    {"id": "S168", "zh": "我们应该一起去。", "chinglish": "We should together go.", "standard": "We should go together.", "pattern": "P14", "notes": "'together' before the verb, as in Chinese."},
    {"id": "S169", "zh": "这个很好啊。", "chinglish": "This is very good ah.", "standard": "This is really good!", "pattern": "P15", "notes": "The particle '啊' (ah) adds emphasis at the end."},
    {"id": "S170", "zh": "我们走吧。", "chinglish": "Let's go ba.", "standard": "Let's go.", "pattern": "P15", "notes": "'吧' (ba) is a suggestion particle — nothing in English."},
    {"id": "S171", "zh": "你想要什么呢？", "chinglish": "What do you want ne?", "standard": "What do you want?", "pattern": "P15", "notes": "'呢' (ne) softens a question; often dropped in English."},
    {"id": "S172", "zh": "他就是不来嘛。", "chinglish": "He just no come ma.", "standard": "He just won't come.", "pattern": "P15", "notes": "'嘛' (ma) states the obvious."},
    {"id": "S173", "zh": "没关系啦。", "chinglish": "That's OK la.", "standard": "That's fine.", "pattern": "P15", "notes": "'啦' (la) — casual, Cantonese-flavoured particle."},
    {"id": "S174", "zh": "我跟你说过了啊。", "chinglish": "I told you already a.", "standard": "I already told you!", "pattern": "P15", "notes": "'啊' (a) marks impatience or reminder."},
    {"id": "S175", "zh": "来吧。", "chinglish": "Come on la.", "standard": "Come on.", "pattern": "P15", "notes": "Encouragement + particle."},
    {"id": "S176", "zh": "你知道嘛，我英语不好。", "chinglish": "You know ma, I no good English.", "standard": "You know, my English isn't great.", "pattern": "P15", "notes": "'嘛' mid-sentence softens the topic."},
    {"id": "S177", "zh": "好累啊。", "chinglish": "Very tired a.", "standard": "I'm so tired.", "pattern": "P15", "notes": "No subject, no copula, trailing 'a'."},
    {"id": "S178", "zh": "等一下吧。", "chinglish": "Wait a moment ba.", "standard": "Wait a moment.", "pattern": "P15", "notes": "Suggestion particle at the end."},
    {"id": "S179", "zh": "没问题啦。", "chinglish": "No problem la.", "standard": "No problem.", "pattern": "P15", "notes": "Casual closing particle."},
    {"id": "S180", "zh": "这个挺贵呢。", "chinglish": "This one expensive ne.", "standard": "This one is rather pricey.", "pattern": "P15", "notes": "'呢' (ne) adds a knowing tone; no copula either."}
  ]
}
